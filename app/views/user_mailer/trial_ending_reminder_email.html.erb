<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body { font-family: Arial, sans-serif; color: #333; }
    .container { max-width: 600px; margin: 0 auto; padding: 20px; }
    .header { background: #ff9800; color: white; padding: 20px; text-align: center; border-radius: 5px; }
    .content { padding: 20px; border: 1px solid #ddd; margin-top: 20px; }
    .button { background: #2196F3; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px; display: inline-block; margin-top: 15px; }
    .footer { text-align: center; color: #999; font-size: 12px; margin-top: 20px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>⏰ Your Trial Ends in <%= @days_left %> Days</h1>
    </div>

    <div class="content">
      <p>Hi <%= @owner.first_name || 'there' %>,</p>

      <p>Your free trial will expire on <strong><%= @subscription.trial_ends_at.strftime('%B %d, %Y') %></strong>.</p>

      <p>To keep using WorkspaceHub, please choose a plan before your trial expires.</p>

      <a href="<%= billing_url %>" class="button">Choose a Plan</a>
    </div>

    <div class="footer">
      <p>© <%= Date.today.year %> WorkspaceHub. All rights reserved.</p>
    </div>
  </div>
</body>
</html>
